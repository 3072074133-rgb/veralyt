ANALYSE_AGENT_OLLAMA_HOST=http://127.0.0.1:11434
ANALYSE_AGENT_OLLAMA_MODEL=qwen3.5:4b
# Import safety limits. Reject oversized decompressed workbooks and pathological sheets early.
ANALYSE_AGENT_MAX_XLSX_UNCOMPRESSED_SIZE=1073741824
ANALYSE_AGENT_MAX_XLSX_COMPRESSION_RATIO=100
ANALYSE_AGENT_MAX_ROWS_PER_SHEET=500000
ANALYSE_AGENT_MAX_COLUMNS_PER_SHEET=2000
ANALYSE_AGENT_MAX_NONEMPTY_CELLS=2000000
ANALYSE_AGENT_MAX_CSV_FIELD_CHARS=100000

# Normal requests use 16K. Only compressed requests that still do not fit may use 32K.
ANALYSE_AGENT_MODEL_CONTEXT_TOKENS=16384
ANALYSE_AGENT_MODEL_MAX_CONTEXT_TOKENS=32768
ANALYSE_AGENT_MODEL_INPUT_SAFETY_TOKENS=768
ANALYSE_AGENT_MODEL_CLASSIFIER_OUTPUT_TOKENS=512
ANALYSE_AGENT_MODEL_DEFAULT_OUTPUT_TOKENS=1536
ANALYSE_AGENT_MODEL_DRAFT_OUTPUT_TOKENS=3072
ANALYSE_AGENT_MODEL_SUMMARY_OUTPUT_TOKENS=2048
ANALYSE_AGENT_MODEL_SUMMARY_MAX_OUTPUT_TOKENS=4096

# Applied when start.ps1 has to launch the local Ollama service.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
