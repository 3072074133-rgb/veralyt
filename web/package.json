{
  "name": "analyse-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "npm run api:generate && vue-tsc --noEmit -p tsconfig.app.json",
    "build": "npm run api:generate && vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "api:schema": "..\\.venv\\Scripts\\python.exe ..\\scripts\\export_openapi.py",
    "api:generate": "npm run api:schema && openapi-typescript openapi.json -o src/generated/api-schema.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ag-grid-community": "^34.2.0",
    "ag-grid-vue3": "^34.2.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.0",
    "lucide-vue-next": "^0.544.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.9.2",
    "unocss": "^66.5.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
